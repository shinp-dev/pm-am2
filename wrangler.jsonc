{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pm-a2-study",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pm-a2-study",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_table": "pm_a2_migrations"
  }]
}
